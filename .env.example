# Set hosted values as secrets, never in source control.
OPENAI_API_KEY=
OPENAI_MODEL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
RAZORPAY_WEBHOOK_SECRET=
BILLING_ENABLED=false

# Standalone customer host only (Vercel). These are server-only variables.
# Do not set SCHEMA_CUSTOMER_HOST on the private Sites deployment.
SCHEMA_CUSTOMER_HOST=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=
# No service-role or SMTP key is needed in Vercel for Phase 1.
# Edge Functions use provider-managed server credentials; Auth owns SMTP.

# AZINHACK: TinyFish is opt-in for public event links only. Set these in your host secret store.
TINYFISH_ENABLED=false
TINYFISH_API_KEY=
TINYFISH_ALLOWED_EMAILS=

# Optional isolated hackathon AI demo (disabled until configured)
AI_ENABLED=false
AI_ALLOWED_EMAILS=
